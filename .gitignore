# ============================================================
# 囧次元逆向项目 .gitignore
# 原则：入库文档 / 代码 / 样本数据；排除第三方工具、大二进制与解包产物
#
# 目录分层见 README.md「目录结构」，权威校验由 `pnpm validate` 执行。
# ============================================================

# ===== 第三方工具链（体积大，可由 pnpm tools:install 恢复）=====
tools/blutter/
tools/jadx/
tools/platform-tools/
tools/*.jar
tools/*.apk
tools/*.so
tools/*.so.*
tools/fs
tools/fs_test.xz
tools/re-env/

# ===== 原始样本（二进制，不入库）=====
assets/apk/*.apk
reflutter_work/*.apk
reflutter_work/*.apk.idsig
libcore.so

# ===== 研究区（白名单入库：代码 + 小型样本）=====
# research/ 本体约 8.8GB（抓包 4.3G / 报告 1.5G / 引擎镜像 1.5G / 标定转储等），
# 除下列白名单外一律不入库；二进制镜像的重建步骤见 research/README.md。
research/*
!research/README.md
!research/*.py
!research/deliverables/
!research/corpus/
!research/toolchain/
!research/captures/
research/captures/*
!research/captures/rsa_scan/
research/captures/rsa_scan/*
!research/captures/rsa_scan/*.pem
!research/captures/rsa_scan/*.py
!research/captures/rsa_scan/*.md
!research/captures/rsa_scan/*.jsonl
!research/engine_c/
research/engine_c/*
!research/engine_c/*.dll
# 阶段报告：README「证据可复现」约定要求结论所指向的报告可被检出。
# 只放行纯文本 .md（顶层 29 篇 + handoff/ 14 篇，合计约 612 KB）；
# 同目录下的 json/jsonl/txt 转储与 dec/ 仍不入库。
!research/reports/
research/reports/*
!research/reports/*.md
!research/reports/handoff/
research/reports/handoff/*
!research/reports/handoff/*.md
# 文档引用的实测脚本与留档结果
!research/tmp_all_endpoints_par.py
!research/tmp_all_endpoints.json
!research/tmp_w1_playchain.py
!research/tmp_w1_playchain_out.json
!research/tmp_w1_playtest.py
!research/tmp_w1_playtest_out.json
# 研究区运行时产物（不入库）
research/deliverables/.auth_cache.json

# ===== 隔离区（待清除的冗余产物，不入库）=====
_trash_*/

# ===== reflutter 大文件工作产物 =====
reflutter_work/dump.dart
reflutter_work/dump2.dart
reflutter_work/dump_parsed.jsonl
reflutter_work/dump2_parsed.jsonl

# ===== 运行环境与临时文件 =====
.workbuddy-ai/
node_modules/
.pnpm-store/
.venv/
.jcy-download-*/
__pycache__/
*.pyc
*.log
*.tmp
.DS_Store
Thumbs.db
.workbuddy
.zcode/
# ===== 前端构建产物 =====
src/web/dist/
src/web/server/__pycache__/

# ===== 安卓客户端（src/app）产物 =====
# 依赖 / Web 产物 / Gradle 构建 / CMake 构建 / 从 APK 提取的 so
src/app/node_modules/
src/app/www/
src/app/android/.gradle/
src/app/android/build/
src/app/android/app/build/
src/app/android/app/.cxx/
src/app/android/local.properties
src/app/android/capacitor-cordova-android-plugins/
src/app/android/capacitor.settings.gradle
src/app/android/app/capacitor.build.gradle
src/app/android/app/src/main/assets/public/
src/app/android/app/src/main/jniLibs/arm64-v8a/libcore.so
src/app/dist/

# cap sync 每次重写这两份资产清单
src/app/android/app/src/main/assets/capacitor.config.json
src/app/android/app/src/main/assets/capacitor.plugins.json

# ===== 前端工具链缓存 =====
src/web/.registry/
*.tsbuildinfo
